# =========================================================================
# Luminous Dental - Supabase Authentication & Storage Environment Variables
# =========================================================================

# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public Key (found in Project Settings -> API)
# Safe to expose in the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OPTIONAL: Supabase Service Role Key (SERVER-ONLY, NEVER EXPOSE TO CLIENT)
# Only required for administrative background tasks or migrations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API Key for 24/7 AI Receptionist (DenTo)
GEMINI_API_KEY=your-gemini-api-key-here
